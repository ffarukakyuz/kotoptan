# Cloudflare Pages HTTP Headers for Kotoptan

# 1. Hashed Vite assets: cache immutably for speed
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Dynamic API endpoints: never cache
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# 3. Web App Manifests: immediate revalidation on mobile
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# 4. Logos, Favicon and PWA App Icons: revalidate with server
/kotoptan-logo.jpg
  Cache-Control: public, max-age=0, must-revalidate
/kotoptan-logo-v2.jpg
  Cache-Control: public, max-age=0, must-revalidate
/logo.jpg
  Cache-Control: public, max-age=0, must-revalidate
/favicon.png
  Cache-Control: public, max-age=0, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate
/icon-192x192.png
  Cache-Control: public, max-age=0, must-revalidate
/icon-512x512.png
  Cache-Control: public, max-age=0, must-revalidate
/icons/*
  Cache-Control: public, max-age=0, must-revalidate

# 5. HTML Shell and Pages: prevent stale mobile browser cache
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
